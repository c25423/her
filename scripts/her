#!/usr/bin/env bash
set -euo pipefail

IMAGE="${HER_IMAGE:-ghcr.io/c25423/her:latest}"
HER_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Create bind sources so docker doesn't auto-create them root-owned
mkdir -p "$HER_ROOT/claude/data" "$HER_ROOT/codex/data" "$HER_ROOT/pi/data"
[ -f "$HER_ROOT/claude/.claude.json" ] || touch "$HER_ROOT/claude/.claude.json"

# Set container name to her-{folder}-{timestamp YYYYMMDDHHmmss}
folder="$(basename "$PWD" | tr -cs 'a-zA-Z0-9._-' '-' | sed -e 's/^[-_.]*//' -e 's/[-_.]*$//')"
[ -n "$folder" ] || folder="dir"
name="her-${folder}-$(date +%Y%m%d%H%M%S)"

if [ $# -eq 0 ]; then
    set -- zsh
else
    set -- zsh -c "$*"
fi

exec docker run -it --rm \
    --name "$name" \
    --security-opt seccomp=unconfined \
    -v "$PWD:$PWD" \
    -w "$PWD" \
    -v "$HER_ROOT/claude/.claude.json:/root/.claude.json" \
    -v "$HER_ROOT/claude/data:/root/.claude" \
    -v "$HER_ROOT/codex/data:/root/.codex" \
    -v "$HER_ROOT/pi/data:/root/.pi" \
    "$IMAGE" "$@"
